From c79e40c197c0a3f178103bbe4df8902a2602d58e Mon Sep 17 00:00:00 2001
From: lattice-repro <repro@localhost>
Date: Mon, 26 May 2025 00:00:00 +0000
Subject: [PATCH 1/3] repro: workspace - drop missing "tests" member, exclude
 htee_* crates

Upstream Cargo.toml lists "tests" as a workspace member, but no tests/
directory exists, so cargo cannot load the workspace at all.
The htee_* crates (an inactive variant) are matched by "crates/*" but
reference a workspace dependency (htee_device) that is not declared in
[workspace.dependencies]; they are not used by platform/qemu-virt or
runtime, so they are excluded. No source code is changed.
---
 Cargo.toml | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/Cargo.toml b/Cargo.toml
index a51e0cb..fcad82f 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,10 +1,19 @@
 [workspace]
 members = [
-    "tests",
     "runtime",
     "crates/*",
     "platform/*", 
 ]
+exclude = [
+    "crates/htee_channel",
+    "crates/htee_client",
+    "crates/htee_console",
+    "crates/htee_device",
+    "crates/htee_linkedlist",
+    "crates/htee_macro",
+    "crates/htee_mempool",
+    "crates/htee_vstack",
+]
 resolver = "2"
 
 [workspace.dependencies]
